{
  "name": "familie-ba-minside-mikrofrontend",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"No tests yet\"",
    "validate": "npm run typecheck && npm run check"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/node": "10.1.2",
    "@astrojs/react": "5.0.6",
    "@navikt/aksel-icons": "8.11.0",
    "@navikt/ds-css": "8.11.0",
    "@navikt/ds-react": "8.11.0",
    "@navikt/oasis": "4.1.4",
    "@navikt/pino-logger": "5.0.0",
    "astro": "6.4.2",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "24.12.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "postcss": "8.5.26",
    "postcss-prefix-selector": "2.1.1",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,css,astro}": [
      "biome check ."
    ]
  }
}
